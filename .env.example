# Bunny · 环境变量模板
#
# 复制为 .env 并填入真实值：
#     cp .env.example .env
#
# ⚠️ .env 已在 .gitignore，永远不要 commit 真实 key
# ⚠️ 不要把真实 key paste 到 chat / log / commit / issue
# ⚠️ 若怀疑泄露，在对应平台控制台立刻 rotate

# -----------------------------------------------------------------------------
# MiniMax（生图 / 一次性 TTS 调试用）
# -----------------------------------------------------------------------------
# 在 MiniMax 控制台申请：https://api.minimaxi.com
MINIMAX_API_KEY=

# -----------------------------------------------------------------------------
# 腾讯云 TTS（生产默认，儿童女声智童 101016）
# -----------------------------------------------------------------------------
# 在 https://console.cloud.tencent.com/cam/capi 创建 API 密钥
# 然后在 https://console.cloud.tencent.com/tts 开通 TTS 服务
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_APP_ID=

# 儿童女声（默认 Bunny 项目首选）
TENCENT_VOICE_TYPE=101016

# 输出音频参数
TENCENT_CODEC=mp3
TENCENT_SAMPLE_RATE=16000
TENCENT_REGION=ap-guangzhou
TENCENT_SPEED=0
TENCENT_VOLUME=0

# -----------------------------------------------------------------------------
# 运行时开关（可选）
# -----------------------------------------------------------------------------
# 是否使用占位音频（无 API key 时自动 true）
VITE_USE_PLACEHOLDER_AUDIO=true
# 是否使用 SVG 占位插画（无 API key 时自动 true）
VITE_USE_PLACEHOLDER_ART=true
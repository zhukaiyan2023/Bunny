{
  "name": "bunny-chinese-literacy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bunny — Chinese literacy & reading platform for kids. H5 runtime + content pipeline.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",

    "manifest": "node tools/cue-manifest.mjs --out content/manifest.json",
    "manifest:dry": "node tools/cue-manifest.mjs --dry-run",

    "art:make": "node tools/build-art-minimax.mjs",
    "art:force": "node tools/build-art-minimax.mjs --force",
    "art:only": "node tools/build-art-minimax.mjs --only",
    "art:dry": "node tools/build-art-minimax.mjs --dry-run",

    "audio:tencent": "node tools/build-audio-tencent.mjs",
    "audio:tencent:force": "node tools/build-audio-tencent.mjs --force",
    "audio:tencent:only": "node tools/build-audio-tencent.mjs --only",
    "audio:tencent:dry": "node tools/build-audio-tencent.mjs --dry-run",

    "placeholders": "node tools/make-placeholders.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright": "^1.49.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}